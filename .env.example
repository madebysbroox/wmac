SQUARE_RELAY_BASE_URL=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com
SQUARE_RELAY_SYNC_TOKEN=replace-with-the-same-long-token-used-during-relay-deploy

# Optional fallback for direct Square API sync:
# SQUARE_ACCESS_TOKEN=
# SQUARE_ENVIRONMENT=production
# SQUARE_LOCATION_ID=

# Optional World Bankcard POS transaction staging. Prefer a relay if World Bankcard needs a
# cloud/webhook bridge, or point WORLDBANKCARD_TRANSACTIONS_URL at an approved
# transaction export endpoint that returns JSON with payments/transactions.
# WORLDBANKCARD_RELAY_BASE_URL=https://YOUR_WORLDBANKCARD_RELAY.example.com
# WORLDBANKCARD_RELAY_SYNC_TOKEN=replace-with-a-long-local-sync-token
# WORLDBANKCARD_TRANSACTIONS_URL=
# WORLDBANKCARD_ACCESS_TOKEN=
# WORLDBANKCARD_API_KEY=
# WORLDBANKCARD_API_KEY_HEADER=x-api-key
# WORLDBANKCARD_BASIC_AUTH=username:password
